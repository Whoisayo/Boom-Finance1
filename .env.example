# Copy this file to .env and fill in your own values. NEVER commit .env itself.

PORT=3001

# Required for login to work at all. Generate a random one with:
#   openssl rand -hex 32
# (run that in Terminal, paste the result here)
SESSION_SECRET=

# Get this from https://console.anthropic.com — needed for the AI Coach to work at all.
ANTHROPIC_API_KEY=

# Get these from https://enablebanking.com after registering an application.
# APPLICATION_ID is shown on your application's page after registering.
# PRIVATE_KEY_PATH points to the .pem private key file you download during
# registration — see README.md for exactly where to put this file.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=./enable_banking_private_key.pem
